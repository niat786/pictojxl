---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  entry: CollectionEntry<'seo'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { comparisonRows, comparisonTitle, faqs } = entry.data;

const useCodecMatrix = comparisonRows.some(
  (row) => row.fileSize || row.lossless || row.alpha || row.encodingSpeed,
);
---

<article class="seo-article mx-auto max-w-3xl px-4 py-14 sm:px-6">
  <div
    class="prose-seo space-y-4 text-lg leading-relaxed text-slate-600 [&_a]:text-sky-600 [&_a]:underline-offset-2 hover:[&_a]:underline [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-slate-900 [&_h3]:mt-6 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-slate-900 [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5 [&_p]:mb-4 [&_strong]:font-medium [&_strong]:text-slate-900 [&_ul]:my-4 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5"
  >
    <Content />
  </div>

  <section class="mt-10">
    <h2 class="text-2xl font-semibold tracking-tight text-slate-900">{comparisonTitle}</h2>
    <div class="mt-4 overflow-x-auto rounded-sm border border-slate-200 bg-white shadow-sm">
      {
        useCodecMatrix ? (
          <table class="w-full min-w-[36rem] text-left text-base">
            <thead class="bg-slate-50 text-sm uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-4 py-3 font-medium">Format</th>
                <th class="px-4 py-3 font-medium">File size</th>
                <th class="px-4 py-3 font-medium">Lossless</th>
                <th class="px-4 py-3 font-medium">Alpha</th>
                <th class="px-4 py-3 font-medium">Encoding speed</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr class="border-t border-slate-100 text-slate-700">
                  <td class="px-4 py-3 font-medium text-slate-900">{row.format}</td>
                  <td class="px-4 py-3">{row.fileSize}</td>
                  <td class="px-4 py-3">{row.lossless}</td>
                  <td class="px-4 py-3">{row.alpha}</td>
                  <td class="px-4 py-3">{row.encodingSpeed}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <table class="w-full min-w-[32rem] text-left text-base">
            <thead class="bg-slate-50 text-sm uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-4 py-3 font-medium">Format</th>
                <th class="px-4 py-3 font-medium">Strength</th>
                <th class="px-4 py-3 font-medium">JXL advantage</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr class="border-t border-slate-100 text-slate-700">
                  <td class="px-4 py-3 font-medium text-slate-900">{row.format}</td>
                  <td class="px-4 py-3">{row.strength}</td>
                  <td class="px-4 py-3">{row.jxlAdvantage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl font-semibold tracking-tight text-slate-900">
      Frequently Asked Questions
    </h2>
    <div class="mt-4 space-y-3">
      {
        faqs.map((faq) => (
          <details class="rounded-sm border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <summary class="cursor-pointer list-none font-medium text-slate-900">
              {faq.question}
            </summary>
            <p class="mt-2 text-base leading-relaxed text-slate-600">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <nav class="mt-12 border-t border-slate-200 pt-8" aria-label="Related converters">
    <h2 class="text-lg font-semibold text-slate-900">Related converters</h2>
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-base">
      <li>
        <a class="text-sky-600 hover:underline" href="/">JXL converter</a>
      </li>
      <li>
        <a class="text-sky-600 hover:underline" href="/png-to-jxl">PNG to JXL</a>
      </li>
      <li>
        <a class="text-sky-600 hover:underline" href="/jpg-to-jxl">JPG to JXL</a>
      </li>
      <li>
        <a class="text-sky-600 hover:underline" href="/webp-to-jxl">WebP to JXL</a>
      </li>
      <li>
        <a class="text-sky-600 hover:underline" href="/avif-to-jxl">AVIF to JXL</a>
      </li>
      <li>
        <a class="text-sky-600 hover:underline" href="/jxl-to-jpg">JXL to JPG</a>
      </li>
      <li>
        <a class="text-sky-600 hover:underline" href="/bulk-jxl-converter">Bulk JXL converter</a>
      </li>
    </ul>
  </nav>
</article>
