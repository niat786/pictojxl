---
import '../styles/global.css';
import { absoluteUrl, buildWebApplicationLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'PictoJXL — Private JPEG XL Converter in Your Browser',
  description = 'Turn PNG, JPG, WebP, and AVIF into JPEG XL with PictoJXL. Encode on-device with WebAssembly, inspect side by side, and export ZIP batches—no uploads.',
  canonicalPath = '/',
  ogImage = '/og.png',
  keywords = [
    'pictojxl',
    'jpeg xl converter',
    'convert images to jxl',
    'private jxl encoder',
  ],
  jsonLd,
} = Astro.props;

const canonical = absoluteUrl(canonicalPath);
const absoluteOg = absoluteUrl(ogImage);

const defaultJsonLd = buildWebApplicationLd({
  name: 'PictoJXL',
  description,
  url: absoluteUrl('/'),
});

const schemas = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [defaultJsonLd];

const navLinks = [
  { href: '/png-to-jxl', label: 'PNG→JXL' },
  { href: '/jpg-to-jxl', label: 'JPG→JXL' },
  { href: '/webp-to-jxl', label: 'WebP→JXL' },
  { href: '/bulk-jxl-converter', label: 'Bulk' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const footerConvertLinks = [
  { href: '/png-to-jxl', label: 'PNG to JXL' },
  { href: '/jpg-to-jxl', label: 'JPG to JXL' },
  { href: '/webp-to-jxl', label: 'WebP to JXL' },
  { href: '/avif-to-jxl', label: 'AVIF to JXL' },
  { href: '/jxl-to-jpg', label: 'JXL to JPG' },
  { href: '/bulk-jxl-converter', label: 'Bulk converter' },
];

const footerCompanyLinks = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const footerLegalLinks = [
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms-of-service', label: 'Terms of Service' },
  { href: '/cookie-policy', label: 'Cookie Policy' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="pictojxl" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    {
      schemas.filter(Boolean).map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="font-sans antialiased">
    <div class="w-full pb-0">
      <div class="shell min-h-screen overflow-hidden rounded-none">
        <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/70 backdrop-blur-xl">
          <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 sm:py-4">
            <a
              href="/"
              class="group flex min-w-0 items-center overflow-hidden rounded-sm bg-[#0b1220] px-2.5 py-1.5 no-underline ring-1 ring-slate-900/10"
              aria-label="pictojxl home"
            >
              <img
                src="/logo.png"
                alt="pictojxl"
                width="1000"
                height="261"
                class="h-[30px] w-auto max-w-[min(70vw,14rem)] object-contain object-left sm:h-[28px] sm:max-w-[15rem] md:h-[34px] md:max-w-[17rem]"
                decoding="async"
              />
            </a>

            <nav
              class="hidden items-center gap-1 rounded-full border border-slate-200/80 bg-slate-100/80 p-1 text-sm text-slate-600 md:flex"
              aria-label="Primary"
            >
              {
                navLinks.slice(0, 4).map((link) => (
                  <a
                    href={link.href}
                    class="rounded-full px-3.5 py-2 transition hover:bg-white hover:text-slate-900"
                  >
                    {link.label}
                  </a>
                ))
              }
            </nav>

            <button
              type="button"
              id="mobile-nav-toggle"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:bg-slate-50 md:hidden"
              aria-controls="mobile-nav"
              aria-expanded="false"
              aria-label="Open menu"
            >
              <svg
                id="mobile-nav-icon-open"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M4 7h16M4 12h16M4 17h16"></path>
              </svg>
              <svg
                id="mobile-nav-icon-close"
                class="hidden h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M6 6l12 12M18 6L6 18"></path>
              </svg>
            </button>
          </div>

          <nav
            id="mobile-nav"
            class="hidden border-t border-slate-200/80 bg-white/95 md:hidden"
            aria-label="Mobile"
            hidden
          >
            <div class="flex flex-col gap-1 px-4 py-3">
              {
                navLinks.map((link) => (
                  <a
                    href={link.href}
                    class="rounded-2xl px-3 py-3 text-base text-slate-700 transition hover:bg-sky-50 hover:text-slate-950"
                  >
                    {link.label}
                  </a>
                ))
              }
            </div>
          </nav>
        </header>

        <main class="px-0">
          <slot />
        </main>

        <footer class="mt-12 border-t border-slate-200 bg-slate-950 text-slate-300">
          <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-14">
            <div class="grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-16">
              <div class="max-w-md">
                <a
                  href="/"
                  class="inline-flex items-center overflow-hidden rounded-sm bg-[#0b1220] px-2.5 py-1.5 ring-1 ring-white/10"
                  aria-label="pictojxl home"
                >
                  <img
                    src="/logo.png"
                    alt="pictojxl"
                    width="1000"
                    height="261"
                    class="h-7 w-auto object-contain object-left"
                    decoding="async"
                  />
                </a>
                <p class="mt-5 text-base leading-relaxed text-slate-300">
                  PictoJXL encodes JPEG XL in your tab. Compare originals, tune settings, and save
                  .jxl files without creating a remote copy of your pictures.
                </p>
                <p
                  class="mt-5 inline-flex items-center gap-2 rounded-sm border border-sky-400/30 bg-sky-500/10 px-3 py-2 text-sm font-semibold text-sky-200"
                >
                  <span class="size-1.5 rounded-full bg-sky-400" aria-hidden="true"></span>
                  Encodes locally · nothing uploaded for conversion
                </p>
              </div>

              <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
                <div>
                  <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
                    Convert
                  </h2>
                  <ul class="mt-4 space-y-2.5">
                    {
                      footerConvertLinks.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            class="text-sm font-medium text-slate-200 transition hover:text-white"
                          >
                            {link.label}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
                <div>
                  <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
                    Company
                  </h2>
                  <ul class="mt-4 space-y-2.5">
                    {
                      footerCompanyLinks.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            class="text-sm font-medium text-slate-200 transition hover:text-white"
                          >
                            {link.label}
                          </a>
                        </li>
                      ))
                    }
                    <li>
                      <a
                        href="mailto:support@pictojxl.com"
                        class="text-sm font-medium text-slate-200 transition hover:text-white"
                      >
                        support@pictojxl.com
                      </a>
                    </li>
                  </ul>
                </div>
                <div class="col-span-2 sm:col-span-1">
                  <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
                    Legal
                  </h2>
                  <ul class="mt-4 space-y-2.5">
                    {
                      footerLegalLinks.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            class="text-sm font-medium text-slate-200 transition hover:text-white"
                          >
                            {link.label}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>

            <div
              class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between"
            >
              <p>
                © {year} pictojxl.com
              </p>
              <p class="font-medium text-slate-400">
                Built for private, on-device conversion
              </p>
            </div>
          </div>
        </footer>
      </div>
    </div>

    <script>
      const toggle = document.getElementById('mobile-nav-toggle');
      const panel = document.getElementById('mobile-nav');
      const iconOpen = document.getElementById('mobile-nav-icon-open');
      const iconClose = document.getElementById('mobile-nav-icon-close');

      function setOpen(open: boolean) {
        if (!toggle || !panel || !iconOpen || !iconClose) return;
        panel.classList.toggle('hidden', !open);
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
      }

      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        setOpen(open);
      });

      panel?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });
    </script>
  </body>
</html>
