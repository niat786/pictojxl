---
import Layout from '../layouts/Layout.astro';
import { absoluteUrl, buildBreadcrumbLd } from '../lib/seo';

const title = 'Contact PictoJXL | support@pictojxl.com';
const description =
  'Email support@pictojxl.com for product help, privacy questions, or advertising inquiries about PictoJXL.';

const jsonLd = [
  buildBreadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact PictoJXL',
    url: absoluteUrl('/contact'),
    about: {
      '@type': 'Organization',
      name: 'Webwise Private Company Ltd',
      email: 'support@pictojxl.com',
      url: absoluteUrl('/'),
    },
  },
];
---

<Layout title={title} description={description} canonicalPath="/contact" jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="mb-10 border-b border-slate-200 pb-8">
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
        Contact PictoJXL
      </h1>
      <p class="mt-3 text-lg text-slate-600">
        Questions about the studio, privacy wording, or ads on pictojxl.com? Reach the Webwise team
        that publishes PictoJXL—we read product and policy mail at the address below.
      </p>
    </header>

    <div class="grid gap-8 sm:grid-cols-2">
      <div class="card rounded-sm p-6">
        <h2 class="text-lg font-semibold text-slate-900">Email</h2>
        <p class="mt-2 text-base text-slate-600">
          Prefer inbox over forms. Replies usually land within a few business days.
        </p>
        <a
          href="mailto:support@pictojxl.com"
          class="mt-4 inline-flex cursor-pointer rounded-full bg-sky-600 px-4 py-3 text-base font-semibold text-white hover:bg-sky-500"
        >
          support@pictojxl.com
        </a>
      </div>

      <div class="card rounded-sm p-6">
        <h2 class="text-lg font-semibold text-slate-900">Publisher details</h2>
        <ul class="mt-3 space-y-2 text-base text-slate-600">
          <li><strong class="text-slate-900">Operator:</strong> Webwise Private Company Ltd</li>
          <li><strong class="text-slate-900">Country:</strong> United States</li>
          <li><strong class="text-slate-900">Product:</strong> PictoJXL (pictojxl.com)</li>
          <li>
            <strong class="text-slate-900">Site:</strong>
            <a class="text-sky-700 hover:underline" href={absoluteUrl('/')}>pictojxl.com</a>
          </li>
        </ul>
      </div>
    </div>

    <form
      class="card mt-10 space-y-4 rounded-sm p-6"
      action="mailto:support@pictojxl.com"
      method="post"
      enctype="text/plain"
    >
      <h2 class="text-lg font-semibold text-slate-900">Draft a message</h2>
      <p class="text-sm text-slate-500">
        Submitting opens your mail client addressed to support. Nothing from this form is posted to a
        conversion API—PictoJXL does not upload images for encoding.
      </p>
      <label class="block">
        <span class="text-sm font-medium text-slate-700">Name</span>
        <input
          type="text"
          name="name"
          required
          class="mt-1 w-full rounded-sm border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none focus:border-sky-500"
        />
      </label>
      <label class="block">
        <span class="text-sm font-medium text-slate-700">Email</span>
        <input
          type="email"
          name="email"
          required
          class="mt-1 w-full rounded-sm border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none focus:border-sky-500"
        />
      </label>
      <label class="block">
        <span class="text-sm font-medium text-slate-700">Message</span>
        <textarea
          name="message"
          required
          rows="5"
          class="mt-1 w-full rounded-sm border border-slate-300 bg-white px-3 py-2.5 text-slate-900 outline-none focus:border-sky-500"
        ></textarea>
      </label>
      <button
        type="submit"
        class="cursor-pointer rounded-full bg-slate-950 px-5 py-3 text-base font-semibold text-white hover:bg-slate-800"
      >
        Open mail to support
      </button>
    </form>

    <p class="mt-8 text-sm text-slate-500">
      Related:
      <a class="text-sky-700 hover:underline" href="/privacy-policy">Privacy Policy</a>,
      <a class="text-sky-700 hover:underline" href="/terms-of-service">Terms of Service</a>,
      <a class="text-sky-700 hover:underline" href="/about">About</a>.
    </p>
  </section>
</Layout>
