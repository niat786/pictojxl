---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';
import { absoluteUrl, buildBreadcrumbLd } from '../lib/seo';

const title = 'Cookie Policy | pictojxl.com';
const description =
  'Cookie Policy for pictojxl.com — how we and partners such as Google AdSense use cookies, and how you can manage them.';

const jsonLd = [
  buildBreadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Cookie Policy', path: '/cookie-policy' },
  ]),
];
---

<Layout title={title} description={description} canonicalPath="/cookie-policy" jsonLd={jsonLd}>
  <LegalPage
    title="Cookie Policy"
    description="What cookies are, how pictojxl.com uses them, and how you can control them."
  >
    <p>
      This Cookie Policy explains how <strong>Webwise Private Company Ltd</strong> (“we,” “us,” or
      “our”) uses cookies and similar technologies on
      <a href={absoluteUrl('/')}>pictojxl.com</a>. It should be read together with our
      <a href="/privacy-policy">Privacy Policy</a>.
    </p>

    <h2>1. What Are Cookies?</h2>
    <p>
      Cookies are small text files stored on your device when you visit a website. They help sites
      remember preferences, keep services secure, measure traffic, and—where permitted—deliver and
      measure advertising.
    </p>

    <h2>2. How We Use Cookies</h2>
    <h3>Essential cookies</h3>
    <p>
      These cookies (or local browser storage equivalents) are used for basic site navigation,
      security, and remembering interface preferences—such as default quality slider settings or UI
      choices—so the tool works as expected.
    </p>
    <h3>Advertising cookies</h3>
    <p>
      When Google AdSense or similar advertising partners are enabled, advertising cookies may be
      used to manage ad delivery, limit how often you see an ad, and measure ad performance. Google
      and its partners may use cookies to serve ads based on your prior visits to this site and/or
      other sites on the Internet. You can opt out of personalized ads via
      <a href="https://adssettings.google.com" rel="noopener noreferrer" target="_blank"
        >Google Ads Settings</a
      >.
    </p>
    <h3>Analytics cookies</h3>
    <p>
      If analytics tools are enabled, cookies or similar identifiers may help us understand
      aggregate traffic, popular pages, and technical performance so we can improve the Service.
    </p>

    <h2>3. Image Conversion Does Not Rely on Upload Cookies</h2>
    <p>
      Image conversion on pictojxl.com runs locally in your browser with WebAssembly. Cookies are
      not used to upload or store your image files on our servers—because those files are not sent
      to our servers for conversion.
    </p>

    <h2>4. Managing or Disabling Cookies</h2>
    <p>
      You can clear or block cookies through your browser settings. Instructions vary by browser:
    </p>
    <ul>
      <li>
        <strong>Chrome:</strong> Settings → Privacy and security → Cookies and other site data
      </li>
      <li>
        <strong>Safari:</strong> Settings / Preferences → Privacy → Manage Website Data / Cookies
      </li>
      <li>
        <strong>Firefox:</strong> Settings → Privacy &amp; Security → Cookies and Site Data
      </li>
      <li>
        <strong>Edge:</strong> Settings → Cookies and site permissions → Manage and delete cookies
      </li>
    </ul>
    <p>
      Blocking all cookies may affect site functionality, including preference memory and some ad
      experiences.
    </p>

    <h2>5. Updates</h2>
    <p>
      We may update this Cookie Policy periodically. The “Last updated” date at the top of this page
      reflects the latest revision.
    </p>

    <h2>6. Contact</h2>
    <p>
      Webwise Private Company Ltd (USA)<br />
      Email: <a href="mailto:support@pictojxl.com">support@pictojxl.com</a>
    </p>
  </LegalPage>
</Layout>
