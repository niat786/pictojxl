---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';
import { absoluteUrl, buildBreadcrumbLd, buildWebApplicationLd } from '../lib/seo';

const title = 'About PictoJXL | pictojxl.com';
const description =
  'PictoJXL is a private, browser-based JPEG XL studio from Webwise Private Company Ltd—encode, compare, and batch-export without uploading images.';

const jsonLd = [
  buildWebApplicationLd({
    name: 'PictoJXL',
    description,
    url: absoluteUrl('/about'),
  }),
  buildBreadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
];
---

<Layout title={title} description={description} canonicalPath="/about" jsonLd={jsonLd}>
  <LegalPage
    title="About PictoJXL"
    description="A short note on who builds pictojxl.com and what the studio is for."
    updated="October 27, 2026"
  >
    <p>
      <strong>PictoJXL</strong> lives at <strong>pictojxl.com</strong>. It is published by
      <strong>Webwise Private Company Ltd</strong>, a United States company whose developers focus on
      fast, privacy-minded browser utilities.
    </p>

    <h2>The problem we wanted to avoid</h2>
    <p>
      Upload-to-convert sites copy your files to someone else’s disk, often with size caps and slow
      round-trips. PictoJXL takes the opposite route: JPEG XL encode and decode stay in the tab you
      already opened. You get a working studio without creating a remote copy of the shoot.
    </p>

    <h2>How the engine feels in practice</h2>
    <p>
      Drop a picture and WebAssembly workers handle decode and JXL encode on your hardware. A split
      inspector shows original versus result before you download. When you bring a folder, Queue mode
      can run several jobs and pack a ZIP. The point is a calm, local workflow—not a black-box cloud
      job.
    </p>

    <h2>What you will find on the site</h2>
    <ul>
      <li>Single-image inspection with Quality, Effort, and Lossless controls</li>
      <li>Step-by-step and auto-queue modes for multi-file work</li>
      <li>Dedicated routes for PNG, JPG, WebP, AVIF, bulk ZIP, and JXL decode</li>
      <li>Plain-language privacy, terms, and cookie pages</li>
    </ul>

    <h2>Publisher</h2>
    <p>
      Webwise Private Company Ltd<br />
      Product: PictoJXL · pictojxl.com<br />
      Support: <a href="mailto:support@pictojxl.com">support@pictojxl.com</a><br />
      <a href="/contact">Contact page</a>
    </p>
  </LegalPage>
</Layout>
